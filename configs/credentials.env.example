# ---------------------------------------------------------------------------
# credentials.env.example  ->  copy to credentials.env (git-ignored) and fill in
#   cp configs/credentials.env.example configs/credentials.env
#   set -a && source configs/credentials.env && set +a
# PREFERRED: attach a role-based identity to each benchmark host (AWS instance
# profile / Azure managed identity / GCP service account) and leave the static
# keys below BLANK. Static keys are the fallback only. NEVER commit this file
# and NEVER paste these values into chat.
# ---------------------------------------------------------------------------

# ---- AWS (S3 / EBS / EFS) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=af-south-1                 # Cape Town; use your nearest local region

# ---- Azure (Blob / Managed Disk / Files) ----
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONNECTION_STRING=      # or set ACCOUNT+KEY above
AZURE_REGION=southafricanorth

# ---- GCP (GCS via S3 interop / PD / Filestore) ----
GOOGLE_APPLICATION_CREDENTIALS=       # path to service-account json, OR HMAC below
GCP_HMAC_ACCESS_KEY=                  # for GCS S3-interoperability endpoint
GCP_HMAC_SECRET_KEY=
GCP_REGION=africa-south1

# ---- Huawei Cloud (OBS, S3-compatible) ----
HUAWEI_ACCESS_KEY=
HUAWEI_SECRET_KEY=
HUAWEI_OBS_ENDPOINT=                  # e.g. https://obs.af-south-1.myhuaweicloud.com
HUAWEI_REGION=af-south-1

# ---- Alibaba Cloud (OSS, S3-compatible) ----
ALIBABA_ACCESS_KEY=
ALIBABA_SECRET_KEY=
ALIBABA_OSS_ENDPOINT=                 # e.g. https://oss-me-central-1.aliyuncs.com
ALIBABA_REGION=me-central-1

# ---- S3 endpoint used by the elbencho object runs on THIS host ----
# Set these per host to the provider you are benchmarking on it.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
